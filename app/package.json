{
  "name": "vltn-tone-studio",
  "productName": "VLTN Tone Studio",
  "version": "0.5.1",
  "private": true,
  "description": "Desktop editor and librarian for the Valeton GP-5, GP-50 and GP-200 family",
  "homepage": "https://github.com/grzmol/VLTN-Tone-Studio",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:toolkit": "node --test src/renderer/src/gp5/tests/ src/renderer/src/gp200/tests/",
    "build:wasm": "clang --target=wasm32 -O3 -msimd128 -nostdlib -Wl,--no-entry -Wl,--export=a1_process -Wl,--export=__heap_base -Wl,--import-memory -o src/renderer/src/snaptone/a1kernel.wasm src/renderer/src/snaptone/a1kernel.c && clang --target=wasm32 -O3 -msimd128 -nostdlib -Wl,--no-entry -Wl,--export=a2_process -Wl,--export=__heap_base -Wl,--import-memory -o src/renderer/src/snaptone/a2kernel.wasm src/renderer/src/snaptone/a2kernel.c",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.7.9",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.10",
    "lucide-react": "^1.52.0",
    "neural-amp-modeler-wasm": "^2.0.1",
    "onnxruntime-web": "1.30.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "neural-amp-modeler-wasm": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "allowScripts": {
    "electron@43.7.9": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
